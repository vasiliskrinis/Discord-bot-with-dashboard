# Discord application
DISCORD_TOKEN=
CLIENT_ID=
BOT_OWNER_ID=

# Command switches
ENABLE_SLASH_COMMANDS=true
ENABLE_PREFIX_COMMANDS=true
DEFAULT_PREFIX=r!
OWNER_PREFIX=oc

# AI provider: Hugging Face
HUGGING_FACE_API_KEY=your_hugging_face_key_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct:fastest
AI_TIMEOUT_MS=12000
AI_MAX_TOKENS=120
AI_PERSONALITY=Helpful, friendly, strict about safety, and concise.
AI_BEHAVIOR=Help server members, assist moderators, and create Discord embeds from plain descriptions.
AI_MODERATION=true
AI_MODERATION_BLOCK_WORDS=token grabber,raid,nuke server,dox,swat

# Runtime
DATABASE_PATH=data/bot.sqlite
REGISTER_SLASH_ON_READY=true

# Local web dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=
